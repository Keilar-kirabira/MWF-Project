extends layout 

block styles 
  link(rel='stylesheet' href='/css/sidebar.css')
  link(rel='stylesheet' href='/css/sales.css')

block content
  .attendant-dashboard(style="min-width: 100%; padding: 20px; overflow-y: auto;")  
    .container.my-4
      h2.welcome Welcome, Attendant!
      p.text-muted Here is your dashboard overview.

      .row.my-4
        .col-md-4
          .card.text-center.p-3
            h5 Today's Sales
            p.display-6 UGX #{todaysSalesTotal.toLocaleString()}

        .col-md-4
          .card.text-center.p-3
            h5 Raw materials
            p.display-6#wood #{woodTotal} 
        .col-md-4
          .card.text-center.p-3
            h5 Furniture Products
            p.display-6#furniture #{furnitureTotal}

    .container.my-5.mt-6
      h3 Products Available
      .d-flex.justify-content-between.align-items-center.mb-3
        input.form-control.w-25(type="text" id="searchInput" placeholder="Search...")
        //- a.btn.btn-dark(href='/stock') Add New Stock
      include includes/stocktable.pug  

  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js")
