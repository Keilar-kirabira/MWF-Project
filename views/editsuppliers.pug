extends layout2.pug 
block styles 
   link(rel='stylesheet' href='/css/sidebar.css')
   link(rel='stylesheet' href='/css/sales.css')
block content
  div(style="width: 100%; height: 100vh; display: flex; flex-direction: row;")
    // Sidebar
    div(style="width: 25%; height: 100%;")
      include includes/sidebar.pug

    // Main content
    div(style="width: 75%; padding: 20px; overflow-y: auto;")  
      .container.mt-5
        h2.mb-4  Edit Supplier Management Form
        form#supplierForm.mb-4(action=`/editsuppliers/${supplier._id}?_method=PUT ` method='post')
          .row.g-3
            .col-md-6
              label.form-label(for='supplierName') Supplier Name
              input#supplierName.form-control(type='text' placeholder='Supplier Name' name='supplierName'  value=`${supplier.supplierName}` required='')

            .col-md-6
              label.form-label(for='supplierCategory') Supplier Category
              select.form-select(name='supplierCategory' required='')
                option( value=`${supplier.supplierCategory}` selected='' ) #{supplier.supplierCategory}
                option(value='Wood') Wood
                option(value='Furniture') Furniture


            .col-md-6
              label.form-label(for='phoneNumber') Phone Number
              input#phoneNumber.form-control(type='tel' placeholder='Phone Number' name='phoneNumber'  value=`${supplier.phoneNumber}` required='')

            .col-md-6
              label.form-label(for='email') Email
              input#email.form-control(type='email' placeholder='Email' name='email'  value=`${supplier.email}` required='')

            .col-md-6
              label.form-label(for='physicaladdress') Physical Address
              input#physicaladdress.form-control(type='text' placeholder='Physical Address' name='physicaladdress' value=`${supplier.physicaladdress}` required='')

            .col-12
              button#addsupplier.btn.btn-dark(type='submit') Update Supplier

      

      // Scripts
      script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
      script(src='Scripts/suppliers.js')
