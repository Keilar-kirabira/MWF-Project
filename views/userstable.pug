extends layout2.pug 
block styles 
   link(rel='stylesheet' href='/css/sidebar.css')
   link(rel="stylesheet" href="/css/userstable.css")
   link(rel='stylesheet' href='/css/sales.css')

block content 
    .userstable(style="min-width: 100%; padding: 20px; overflow-y: auto;")
      .container.my-5.mt-6

        if success_msg && success_msg.length
          .alert.alert-success.alert-dismissible.fade.show(role='alert')
            | #{success_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')
        
        if error_msg && error_msg.length
          .alert.alert-danger.alert-dismissible.fade.show(role='alert')
            | #{error_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        h3 Users List

        .d-flex.justify-content-between.align-items-center.mb-3
          input.form-control(type="text" id="searchInput" placeholder="Search users..." style="max-width: 300px;")
          a.btn.btn-dark(href='/registeruser')
            i.bi.bi-person-plus.me-2
            | Register New User

        table.table.table-striped.table-bordered
          thead.table
            tr
              th Profile
              th Username
              th Email
              th Phone
              th Role
              th Employee ID
              th(colspan="3") Actions
          tbody
            if users.length 
              each user in users 
                tr
                  td.text-center
                    img(
                      src=`/uploads/${user.profileImage}` 
                      alt=user.userName
                      width="60" 
                      height="60" 
                      style="object-fit:cover; border-radius:50%;"
                    )
                  td #{user.userName}
                  td #{user.email}
                  td #{user.phoneNumber}
                  td 
                    span #{user.role}
                    //- Optional: Uncomment for role badges
                    //- span.role-badge(class=`role-${user.role.toLowerCase()}`) #{user.role}
                  td #{user.employeeId}

                  //- IMPROVED ACTION BUTTONS
                  td.text-center
                    button.btn.btn-info.btn-sm(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#viewUser-${user._id}`
                      title="View Details"
                    )
                      i.bi.bi-eye-fill

                  td.text-center
                    a.btn.btn-warning.btn-sm(
                      href=`/editusers/${user._id}`
                      title="Edit User"
                    )
                      i.bi.bi-pencil-fill    

                  td.text-center
                    button.btn.btn-danger.btn-sm(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#deleteUser-${user._id}`
                      title="Delete User"
                    )
                      i.bi.bi-trash-fill

                  //- Delete Modal
                  div.modal.fade(id=`deleteUser-${user._id}` tabindex="-1" aria-hidden="true")
                    .modal-dialog
                      .modal-content
                        .modal-header
                          h5.modal-title 
                            i.bi.bi-exclamation-triangle.text-danger.me-2
                            | Delete User
                          button.btn-close(type="button" data-bs-dismiss="modal")
                        .modal-body
                          p.mb-2 Are you sure you want to delete 
                            strong "#{user.userName}"
                            | ?
                          p.text-muted.small.mb-0 This action cannot be undone. All user data will be permanently removed.
                        .modal-footer
                          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                          form(method='post' action='/deleteusers' style="display: inline;")
                            input(type='hidden' name='id' value=user._id)
                            button.btn.btn-danger(type='submit')
                              i.bi.bi-trash.me-1
                              | Confirm Delete

                //- View Modal
                div.modal.fade(id=`viewUser-${user._id}` tabindex="-1" aria-hidden="true")
                  .modal-dialog.modal-lg
                    .modal-content
                      .modal-header
                        h5.modal-title
                          i.bi.bi-person-circle.me-2
                          | User Details
                        button.btn-close(type="button" data-bs-dismiss="modal")
                      .modal-body
                        .row.mb-3.text-center
                          .col-12
                            img(
                              src=`/uploads/${user.profileImage}` 
                              alt=user.userName
                              width="100" 
                              height="100" 
                              style="object-fit:cover; border-radius:50%; border: 4px solid #81756e;"
                            )
                            h5.mt-2.mb-0 #{user.userName}
                            p.text-muted #{user.role}
                        
                        .row
                          .col-md-6
                            ul.list-group.list-group-flush
                              li.list-group-item
                                strong Email:
                                | #{user.email}
                              li.list-group-item
                                strong Phone:
                                | #{user.phoneNumber}
                              li.list-group-item
                                strong Date of Birth:
                                | #{user.birthDate}
                              li.list-group-item
                                strong Gender:
                                | #{user.gender}
                              li.list-group-item
                                strong NIN:
                                | #{user.nin}
                          .col-md-6
                            ul.list-group.list-group-flush
                              li.list-group-item
                                strong Employee ID:
                                | #{user.employeeId}
                              li.list-group-item
                                strong Next of Kin:
                                | #{user.nextofKin}
                              li.list-group-item
                                strong NOK Number:
                                | #{user.nokNumber}
                              li.list-group-item
                                strong Role:
                                span.badge.bg-primary.ms-2 #{user.role}
                              li.list-group-item
                                strong Status:
                                span.badge.bg-success.ms-2 Active
                      .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                        a.btn.btn-warning(href=`/editusers/${user._id}`)
                          i.bi.bi-pencil-fill.me-1
                          | Edit User
            else
              tr
                td(colspan="9" class="text-center text-muted")
                  i.bi.bi-people.fs-1.d-block.mb-2(style="opacity: 0.3;")
                  | No users found.        

      script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
      script(src="/js/userstable.js")