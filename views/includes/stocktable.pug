table.table.table-striped.table-bordered
  thead.table
    tr
      th(scope='col') Product Name
      th(scope='col') Product Type
      th(scope='col') Quantity 
      th(scope='col') Selling Price (UGX)
      th(scope='col') Status
      th(scope='col') View 
  tbody#productTable
    if items.length 
      each item in items
        tr
          td #{item.productName}
          td #{item.productType} 
          td.quantity #{item.quantity}
          td.sellingPrice #{item.productPrice}
          td    
            if item.quantity <= 50
              span.badge.bg-warning Low Stock 
            else 
              span.badge.bg-success In Stock  
          td 
            button.btn.btn-info.p-2(
              type='button'
              data-bs-toggle="modal"
              data-bs-target=`#viewModal-${item._id}`
            )  
              i.bi.bi-eye-fill   

          //- View Modal
          div.modal.fade(id=`viewModal-${item._id}` tabindex="-1" aria-hidden="true")
            .modal-dialog
              .modal-content
                .modal-header
                  h5.modal-title Stock Details
                  button.btn-close(type="button" data-bs-dismiss="modal")
                .modal-body
                  ul.list-group
                    li.list-group-item
                      strong Name: 
                      | #{item.productName}
                    li.list-group-item
                      strong Type: 
                      | #{item.productType}
                    li.list-group-item
                      strong Quantity: 
                      | #{item.quantity}
                    li.list-group-item
                      strong Cost Price: 
                      | #{new Intl.NumberFormat().format(item.costPrice)}
                    li.list-group-item
                      strong Total Cost: 
                      | #{new Intl.NumberFormat().format(item.costPrice * item.quantity)}
                    li.list-group-item
                      strong Selling Price: 
                      | #{new Intl.NumberFormat().format(item.productPrice)}
                    li.list-group-item
                      strong Supplier: 
                      | #{item.supplierName}
                    li.list-group-item
                      strong Status: 
                      if item.quantity <= 50
                        span.btn.btn-warning Low Stock
                      else
                        span.btn.btn-success In Stock  
                .modal-footer
                  button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
    else
      tr
        td(colspan="11" class="text-center text-muted")
          | No products available. 
  tfoot
    tr.table
      td(colspan="2") TOTAL
      td#totalQuantity.text-end 0
      td#totalSelling.text-end 0
      td(colspan="2")       

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
script(src="js/stocktable.js")
