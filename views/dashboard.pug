extends layout2.pug 
block styles 
  link(rel='stylesheet' href='/css/sidebar.css')
  link(rel='stylesheet' href='/css/sales.css')
block content
 
  .dashboard.mt-5.p-4(style="overflow-y: auto;")
    h2.mb-3 Welcome to MWF Dashboard, Manager
    p.text-muted.
      Manage your furniture and wood inventory with ease.

    .row.mt-4
      .col-md-3.mb-4
        .card.text-black.bg-white.h-100
          .card-body
            h5.card-title Total Products
            p.card-text 132 in stock

      .col-md-3.mb-4
        .card.text-dark.bg-white.h-100
          .card-body
            h5.card-title Total Sales
            p.card-text UGX 12,000,000 in July

      .col-md-3.mb-4
        .card.text-black.bg-white.h-100
          .card-body
            h5.card-title Pending Deliveries
            p.card-text 4 orders awaiting transport

      .col-md-3.mb-4
        .card.text-danger.bg-white.h-100
          .card-body
            h5.card-title Low Stock
            p.card-text 5 items below reorder level
      //- .col-md-3.mb-4
      //-   .card.text-danger.bg-white.h-100
      //-     .card-body
      //-       h5.card-title Raw Materials
      //-       p.card-text 5 items below reorder level      

   



      .container.my-5.mt-6
        if success_msg && success_msg.length
          .alert.alert-success.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{success_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')
        if error_msg && error_msg.length
          .alert.alert-danger.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{error_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        h3.mb-4 Sales Records
        .d-flex.justify-content-between.mb-3
          input.form-control(type='text', placeholder='Search customername and productname', id='searchInput', style='width: 50%;')
          a.btn.btn-dark(href='/Addsale') Add Sale
      include includes/salestable.pug   

  // Scripts
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
