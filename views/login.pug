doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title MWF | Login
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
    link(rel='stylesheet' href='/css/login2.css')
  body
    .login-container
      .login-card

        .login-left
          .logo
            img(src='/images/mwflogo.png' alt='Mayondo Wood and Furniture Logo')
          h1
            | WELCOME TO 
            br
            | MAYONDO WOOD 
            br
            | AND FURNITURE


        .login-right
          h2 Login
          form#loginForm(action='/login' method='post' novalidate )
            .mb-3
              label.form-label(for='email') Email 
              input#email.form-control(type='text' name='email' placeholder=' Please enter  valid email ' required)
              .invalid-feedback Please enter your valid email.

            .mb-3
              label.form-label(for='password') Password
              .password-wrapper
                input#password.form-control(type='password' name='password' placeholder='Enter password' minlength='6' required)
                span#togglePassword
                  i(class='bi bi-eye')
                .invalid-feedback Password must be at least 6 characters.

            .d-grid
              button.btn.btn-light(type='submit') Login
          div#successMsg.text-success.mt-2
          p.small-links.mt-3
            a(href='#') Forgot password?

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='/js/login.js')
