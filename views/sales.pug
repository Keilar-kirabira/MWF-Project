extends layout.pug 

block styles 
  link(rel='stylesheet' href='/css/sidebar.css')
  link(rel='stylesheet' href='/css/sales.css')

block content
    .sales(style="min-width: 100%; padding: 20px;")  
      
      //- h2.mb-4.text-center Record New Sale
      //- p.text-center
      //-   | Fill in the customer details and finalize the sale.
      h2.mb-4.text-center Sale Entry Form

      // Flash messages
      if error_msg && error_msg.length
        div#flashMsg.alert.alert-danger(role='alert')= error_msg

      if success_msg && success_msg.length
        div#flashMsg.alert.alert-success(role='alert')= success_msg

      form#saleForm(action='/Addsale' method='post' novalidate)
        .row.g-3
          .col-md-6
            label.form-label(for='customerName') Customer Name
            input#customerName.form-control(type='text' name='customerName' placeholder='Enter Customer Name' required='')
            .invalid-feedback Name must contain minimum 3 characters.
          .col-md-6
            label.form-label(for='productName') Product Name
            select#productName.form-select(name='productName' required='')
              if stocks.length 
                each stock in stocks 
                  option(value=stock.productName)= stock.productName
            .invalid-feedback Please select a product.      
          .col-md-6
            label.form-label(for='productType') Type of Product
            select#productType.form-select(name='productType' required='')
              option(value='' selected='' disabled='') Select Product Type...
              option(value='Wood') Wood
              option(value='Furniture') Furniture
            .invalid-feedback Please select product type.   
          .col-md-6
            label.form-label(for='quantity') Quantity
            input#quantity.form-control(type='number' name='quantity' min='1' placeholder='Enter quantity' required='')
            .invalid-feedback Quantity must be 1 or more.
          .col-md-6
            label.form-label(for='unitPrice') Unit Price (UGX)
            input#unitPrice.form-control(type='number' name='unitPrice' min="1" placeholder='Enter unit price' required='')
            .invalid-feedback Unit Price must be 100 UGX or more.
          .col-md-6
            label.form-label(for='totalPrice') Total Price (UGX)
            input#totalPrice.form-control(type='text' name='totalPrice' readonly='')
          .col-md-4
            label.form-check-label(for='transportCheck') Add 5% Transport Fee
            input#transportCheck.form-check-input(type='checkbox' name='transportCheck')
          .col-md-4
            label.form-label(for='paymentType') Type of Payment
            select#paymentType.form-select(name='paymentType' required='')
              option(value='' selected='' disabled='') --Select Payment Type--
              option(value='Cash') Cash
              option(value='Cheque') Cheque
              option(value='Bank Overdraft') Bank Overdraft
            .invalid-feedback Please select type of payment.  
          .col-md-4
            label.form-label(for='paymentDate') Date
            input#paymentDate.form-control(type='date' name='paymentDate' required='')
            .invalid-feedback Date must be today's date.
          
          .col-12
            button.btn.btn-dark(type='submit') Submit Sale

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js')
        script(src='js/sales.js')
        
