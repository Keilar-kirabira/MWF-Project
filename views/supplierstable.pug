extends layout2.pug 
block styles 
   link(rel='stylesheet' href='/css/sidebar.css')
   link(rel='stylesheet' href='/css/sales.css')
block content 
  div(style="width: 100%; height: 100vh; display: flex; flex-direction: row;")
    // Sidebar
    div(style="width: 25%; height: 100%;")
      include includes/sidebar.pug

    // Main content
    div(style="width: 75%; padding: 10px; overflow-y: auto;")
      .container.my-5.mt-6

        if success_msg && success_msg.length
          .alert.alert-success.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{success_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        if error_msg && error_msg.length
          .alert.alert-danger.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{error_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        .d-flex.justify-content-between.align-items-center.mb-3
          h3.mb-0 Suppliers
          a.btn.btn-dark(href='/Addsupplier') Register Supplier

        //- Search field
        .mb-3
          input#searchInput.form-control.w-25(type='text' placeholder='Search suppliers...')

        table.table.table-striped.table-bordered
          thead.table-dark
            tr
              th(scope='col') Supplier Name
              th(scope='col') Supplier Category
              th(scope='col') Phone Number
              th(scope='col') Email
              th(scope='col') Physical Address
              th(scope='col') View 
              th(scope='col') Edit 
              th(scope='col') Delete

          tbody#supplierTable
            if suppliers.length 
              each supplier in suppliers 
                tr 
                  td #{supplier.supplierName}
                  td #{supplier.supplierCategory}
                  td #{supplier.phoneNumber}
                  td #{supplier.email}
                  td #{supplier.physicaladdress}
                  td    
                    button.btn.btn-info.p-2(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#viewModal-${supplier._id}`
                    )
                      i.bi.bi-eye-fill
                  td 
                    a.btn.btn-warning(href=`/editsuppliers/${supplier._id}`)
                      i.bi.bi-pencil-fill 
                  td 
                    button.btn.btn-danger.p-2(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#deleteModal-${supplier._id}`
                    )
                      i.bi.bi-trash-fill             

                // Delete Modal
                div.modal.fade(id=`deleteModal-${supplier._id}` tabindex="-1" aria-hidden="true")
                  .modal-dialog
                    .modal-content
                      .modal-header
                        h5.modal-title Delete Confirmation
                        button.btn-close(type="button" data-bs-dismiss="modal")
                      .modal-body
                        p Are you sure you want to delete "#{supplier.supplierName}"?
                      .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                        form(method='post' action="/deletesuppliers")
                          input(type="hidden" name='id' value=supplier._id)
                          button.btn.btn-danger(type='submit') Confirm Delete    

                // View Modal
                div.modal.fade(id=`viewModal-${supplier._id}` tabindex="-1" aria-hidden="true")
                  .modal-dialog 
                    .modal-content 
                      .modal-header 
                        h5.modal-title Supplier Details 
                        button.btn-close(type="button" data-bs-dismiss="modal")
                      .modal-body 
                        ul.list-group
                          li.list-group-item 
                            strong Supplier Name: 
                            | #{supplier.supplierName} 
                          li.list-group-item 
                            strong Supplier Category: 
                            | #{supplier.supplierCategory}               
                          li.list-group-item 
                            strong Phone Number: 
                            | #{supplier.phoneNumber}  
                          li.list-group-item 
                            strong Email: 
                            | #{supplier.email}
                          li.list-group-item 
                            strong Physical Address: 
                            | #{supplier.physicaladdress}  
                      .modal-footer 
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
            else 
              tr 
                td(colspan='8' class="text-center text-muted") 
                  | No suppliers yet.              

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src="js/supplierstable.js")
