extends layout2.pug 
block styles 
   link(rel='stylesheet' href='/css/sidebar.css')
   link(rel='stylesheet' href='/css/sales.css')
   link(rel='stylesheet' href='/css/supplierstable.css')

block content 
    .supplierstable(style="min-width:100%; padding: 20px; overflow-y: auto;")
      .container.my-5.mt-6

        if success_msg && success_msg.length
          .alert.alert-success.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{success_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        if error_msg && error_msg.length
          .alert.alert-danger.alert-dismissible.fade.show(role='alert' id='flashMsg')
            | #{error_msg[0]}
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

        .d-flex.justify-content-between.align-items-center.mb-3
          h3.mb-0 Suppliers
          a.btn.btn-dark(href='/Addsupplier')
            i.bi.bi-person-plus-fill.me-2
            | Register Supplier

        //- Search field
        .mb-3
          input#searchInput.form-control(type='text' placeholder='Search suppliers by name, category, or contact...')

        table.table.table-striped.table-bordered
          thead.table-dark
            tr
              th(scope='col') Supplier Name
              th(scope='col') Category
              th(scope='col') Phone
              th(scope='col') Email
              th(scope='col') Address
              th(scope='col', colspan='3') Actions

          tbody#supplierTable
            if suppliers.length 
              each supplier in suppliers 
                tr 
                  td 
                    strong #{supplier.supplierName}
                  td #{supplier.supplierCategory}
                    //- Optional: Uncomment for category badges
                    //- span.category-badge(class=`category-${supplier.supplierCategory.toLowerCase().replace(/\s+/g, '-')}`) #{supplier.supplierCategory}
                  td 
                    i.bi.bi-telephone.me-1
                    | #{supplier.phoneNumber}
                  td 
                    i.bi.bi-envelope.me-1
                    | #{supplier.email}
                  td #{supplier.physicaladdress}
                  
                  
                  td.text-center
                    button.btn.btn-info(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#viewModal-${supplier._id}`
                      title="View Details"
                    )
                      i.bi.bi-eye-fill
                  
                  td.text-center
                    a.btn.btn-warning(
                      href=`/editsuppliers/${supplier._id}`
                      title="Edit Supplier"
                    )
                      i.bi.bi-pencil-fill 
                  
                  td.text-center
                    button.btn.btn-danger(
                      type='button'
                      data-bs-toggle="modal"
                      data-bs-target=`#deleteModal-${supplier._id}`
                      title="Delete Supplier"
                    )
                      i.bi.bi-trash-fill             

                //- Delete Modal
                div.modal.fade(id=`deleteModal-${supplier._id}` tabindex="-1" aria-hidden="true")
                  .modal-dialog
                    .modal-content
                      .modal-header
                        h5.modal-title
                          i.bi.bi-exclamation-triangle.text-danger.me-2
                          | Delete Confirmation
                        button.btn-close(type="button" data-bs-dismiss="modal")
                      .modal-body
                        p.mb-2 Are you sure you want to delete 
                          strong "#{supplier.supplierName}"
                          | ?
                        p.text-muted.small.mb-0 This will permanently remove this supplier from your records.
                      .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                        form(method='post' action="/deletesuppliers" style="display: inline;")
                          input(type="hidden" name='id' value=supplier._id)
                          button.btn.btn-danger(type='submit')
                            i.bi.bi-trash.me-1
                            | Confirm Delete    

                //- View Modal
                div.modal.fade(id=`viewModal-${supplier._id}` tabindex="-1" aria-hidden="true")
                  .modal-dialog.modal-lg
                    .modal-content 
                      .modal-header 
                        h5.modal-title
                          i.bi.bi-building.me-2
                          | Supplier Details 
                        button.btn-close(type="button" data-bs-dismiss="modal")
                      .modal-body 
                        .row.mb-3
                          .col-12.text-center
                            .bg-light.rounded-circle.d-inline-flex.align-items-center.justify-content-center(
                              style="width: 80px; height: 80px;"
                            )
                              i.bi.bi-building.fs-1(style="color: #81756e;")
                            h5.mt-2.mb-0 #{supplier.supplierName}
                            p.text-muted.mb-0 #{supplier.supplierCategory}
                        
                        .row
                          .col-md-6
                            ul.list-group.list-group-flush
                              li.list-group-item
                                i.bi.bi-building.me-2.text-muted
                                strong Supplier Name:
                                br
                                | #{supplier.supplierName} 
                              li.list-group-item
                                i.bi.bi-tag.me-2.text-muted
                                strong Category:
                                br
                                | #{supplier.supplierCategory}               
                              li.list-group-item
                                i.bi.bi-telephone.me-2.text-muted
                                strong Phone Number:
                                br
                                a(href=`tel:${supplier.phoneNumber}`) #{supplier.phoneNumber}
                          .col-md-6
                            ul.list-group.list-group-flush  
                              li.list-group-item
                                i.bi.bi-envelope.me-2.text-muted
                                strong Email:
                                br
                                a(href=`mailto:${supplier.email}`) #{supplier.email}
                              li.list-group-item
                                i.bi.bi-geo-alt.me-2.text-muted
                                strong Physical Address:
                                br
                                | #{supplier.physicaladdress}
                              li.list-group-item.bg-light
                                i.bi.bi-calendar-check.me-2.text-muted
                                strong Status:
                                br
                                span.badge.bg-success Active
                      .modal-footer 
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                        a.btn.btn-warning(href=`/editsuppliers/${supplier._id}`)
                          i.bi.bi-pencil-fill.me-1
                          | Edit Supplier
            else 
              tr 
                td(colspan='8' class="text-center text-muted") 
                  i.bi.bi-inbox.fs-1.d-block.mb-2(style="opacity: 0.3;")
                  | No suppliers registered yet.
                  br
                  small Click "Register Supplier" to add your first supplier.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src="js/supplierstable.js")